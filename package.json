{
  "name": "visitas-locacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/worker.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "worker": "node dist/worker.mjs",
    "worker:dev": "tsx src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "lint": "tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@googleapis/calendar": "^20.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "google-auth-library": "^11.1.0",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "railway": "^3.13.0",
    "sharp": "^0.35.5",
    "vitest": "^5.0.3"
  }
}
