# ── Obrigatórias ─────────────────────────────────────────────
# PostgreSQL. No Railway: referencie ${{Postgres.DATABASE_URL}} nos serviços web e worker.
DATABASE_URL=postgresql://usuario:senha@host:5432/visitas
# URL pública do app (https em produção). Usada em links de senha, cookies seguros e OAuth.
APP_URL=https://seu-app.up.railway.app
# 32 bytes aleatórios em base64 — criptografa tokens do Google no banco.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Google Agenda (OAuth de aplicativo web) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional; padrão = ${APP_URL}/api/google/callback (deve ser idêntico ao cadastrado no Google Cloud)
GOOGLE_REDIRECT_URI=

# ── Primeiro administrador ───────────────────────────────────
# Código (>= 16 caracteres) exigido em /configuracao-inicial. A tela só funciona sem usuários cadastrados.
# Remova a variável depois de criar o admin.
SETUP_TOKEN=

# ── Lembretes no celular (Web Push) ─────────────────────────
# Gerar: node -e "console.log(require('web-push').generateVAPIDKeys())"  — mesmas chaves no web e no worker.
# Sem elas, os lembretes ficam desativados (o resto do app funciona).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável (exigido pelos serviços de push), ex.: mailto:ti@imobiliaria.com.br
VAPID_SUBJECT=

# ── Opcionais ───────────────────────────────────────────────
# Intervalo do laço do worker (ms). O intervalo de sincronização em si é configurado no app (padrão 5 min).
WORKER_TICK_MS=15000
# PORT é definido pelo Railway automaticamente.
