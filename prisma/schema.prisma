// Visitas Locação — modelo de dados
// Convenções: datas/horas em UTC (timestamptz); dia operacional calculado em America/Sao_Paulo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Usuários e acesso ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CONSULTANT
  /// pré-atendimento (ex.: Jasmin): cadastra pré-análises e encaminha para consultoras
  PRE_SERVICE
  /// marketing: recebe as locações fechadas para postar
  MARKETING
}

model User {
  id            String    @id @default(cuid())
  name          String
  /// e-mail de login (minúsculo)
  email         String    @unique
  passwordHash  String?
  /// senha provisória definida pela gestão: troca obrigatória no próximo login
  mustChangePassword Boolean @default(false)
  /// gestão: preferir a tela única (Minhas visitas) no celular
  simpleMobile       Boolean @default(false)
  /// ciência do aviso de privacidade (LGPD)
  privacyAcceptedAt  DateTime?
  /// primeiro acesso guiado concluído (ou pulado)
  onboardedAt        DateTime?
  /// "O que mudou": última novidade que a pessoa já viu (id da entrada em src/lib/changelog.ts)
  seenChangelog      String?
  /// conta Google vinculada no "Entrar com Google" (identificador estável do Google)
  googleSub          String?   @unique
  /// consultora ausente (folga/férias) até esta data, inclusive: o rodízio da pré-análise pula
  awayUntil          DateTime? @db.Date
  /// pós-contrato ligado (contato de boas-vindas e pedido de indicação) desde esta data; null = desligado
  aftercareSince     DateTime?
  role          Role
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aliases          UserEmailAlias[]
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  visits           Visit[]                @relation("VisitConsultant")
  realizedVisits   Visit[]                @relation("VisitRealizedBy")
  concludedVisits  Visit[]                @relation("VisitConcludedBy")
  scheduledVisits  Visit[]                @relation("VisitScheduledBy")
  outcomeHistory   VisitOutcomeHistory[]
  opportunities    Opportunity[]          @relation("OppResponsible")
  closedOpps       Opportunity[]          @relation("OppClosedResponsible")
  oppEvents        OpportunityEvent[]
  auditLogs        AuditLog[]
  pushSubscriptions PushSubscription[]
  reminderLogs     ReminderLog[]
  syncRuns         SyncRun[]
  googleConnection GoogleConnection[]
  preAnalysesCreated  PreAnalysis[] @relation("PreAnalysisCreatedBy")
  docRequestsCreated  DocRequest[]  @relation("DocRequestCreatedBy")
  clientSearches      ClientSearch[] @relation("ClientSearchConsultant")
  clientSearchesClosed ClientSearch[] @relation("ClientSearchClosedBy")
  docRequestsAssigned DocRequest[]  @relation("DocRequestConsultant")
  preAnalysesAssigned PreAnalysis[] @relation("PreAnalysisConsultant")
  preAnalysesResolved PreAnalysis[] @relation("PreAnalysisResolvedBy")
  leasePostsCreated   LeasePost[]   @relation("LeasePostCreatedBy")
  leasePostsPosted    LeasePost[]   @relation("LeasePostPostedBy")
  preAnalysisFiles    PreAnalysisFile[]
  proposalsCreated    Proposal[]    @relation("ProposalCreatedBy")
  proposalsAssigned   Proposal[]    @relation("ProposalConsultant")
  proposalsUpdated    Proposal[]    @relation("ProposalStatusBy")
}

/// E-mails usados para reconhecer a consultora entre os convidados do evento.
model UserEmailAlias {
  id        String   @id @default(cuid())
  userId    String
  /// sempre minúsculo, sem espaços
  email     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  /// SHA-256 do token do cookie (o token em si nunca é guardado)
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  /// SHA-256 do token
  id          String    @id
  userId      String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Limitação de tentativas (login, sync manual, reset).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────────────────────────── Configuração ─────────────────────────────

model AppSettings {
  id                       Int      @id @default(1)
  productName              String   @default("Visitas Locação")
  /// app do Google em "modo teste": a conexão expira 7 dias depois de conectar (avisa o admin 1 dia antes)
  googleTestingMode        Boolean  @default(true)
  primaryColor             String   @default("#dc7519")
  timezone                 String   @default("America/Sao_Paulo")
  syncIntervalMinutes      Int      @default(5)
  syncPastDays             Int      @default(30)
  syncFutureDays           Int      @default(90)
  manualSyncMinSeconds     Int      @default(60)
  /// Visitas anteriores a esta data (dia operacional) não geram cobrança de resultado.
  resultsStartDate         DateTime @db.Date
  /// Regras de permissão configuráveis (ver src/lib/authz.ts)
  consultantCanUpdateOpp   Boolean  @default(true)
  consultantCanCreateVisit Boolean  @default(true)
  consultantCanCorrectData Boolean  @default(true)
  noteMaxLength            Int      @default(2000)
  /// lembretes de pendências (notificação no celular)
  remindersEnabled         Boolean  @default(true)
  /// hora local (America/Sao_Paulo) do envio diário
  reminderHour             Int      @default(9)
  /// lembrete antes da visita (minutos de antecedência; 0 = desligado)
  upcomingReminderMinutes  Int      @default(60)
  /// "Como foi a visita?" logo após o término (com atalhos de resultado)
  resultPromptEnabled      Boolean  @default(true)
  /// novo lembrete à consultora N horas após o término sem resultado (0 = desligado)
  resultReminderHours      Int      @default(2)
  /// alerta à gestão quando a visita passa N horas sem resultado (0 = desligado)
  managerAlertHours        Int      @default(24)
  /// evento movido na agenda para este horário ou depois (Brasília) = visita cancelada (0 = desligado)
  cancelAfterHour          Int      @default(21)
  /// LGPD: dias após o resultado para apagar CPF, nascimento, e-mail, telefone e salário da pré-análise
  preAnalysisRetentionDays Int      @default(90)
  /// "Documentos pelo link do cliente" ligado (desligado: some dos menus e os links enviados param de abrir)
  docLinksEnabled          Boolean  @default(false)
  /// cor (paleta do Google, "1"–"11") dos eventos agendados pelas consultoras na agenda central; "" = desligado
  consultantEventColor     String   @default("")
  /// e-mails colocados em cópia nos eventos que as consultoras criam pelo app (reagendar/nova visita), separados por vírgula
  calendarCcEmails         String   @default("")
  /// mensagem de confirmação de presença (WhatsApp aberto pela consultora). {cliente} {consultora} {dia} {hora} {codigo} {bairro}
  /// mensagens prontas para depois da visita (WhatsApp aberto pela consultora). Mesmos campos da confirmação.
  msgAfterPositive         String   @default("Olá, {cliente}! Aqui é {consultora}, da Auxiliadora Predial. Que bom que você gostou do imóvel {codigo}! Para seguirmos com a locação, me envie por aqui: documento com foto (RG ou CNH), comprovante de renda dos últimos 3 meses e comprovante de residência. Qualquer dúvida, estou à disposição.")
  msgAfterUndecided        String   @default("Olá, {cliente}! Aqui é {consultora}, da Auxiliadora Predial. Ficou alguma dúvida sobre o imóvel {codigo}? Posso te ajudar a decidir ou te mostrar outras opções parecidas.")
  msgAfterNegative         String   @default("Olá, {cliente}! Aqui é {consultora}, da Auxiliadora Predial. Obrigada pela visita ao imóvel {codigo}. Tenho outras opções no perfil que você procura. Posso te enviar algumas?")
  msgAfterNoShow           String   @default("Olá, {cliente}! Aqui é {consultora}, da Auxiliadora Predial. Senti sua falta na visita ao imóvel {codigo}. Quer remarcar? Me diga o melhor dia e horário para você.")
  confirmMessage           String   @default("Olá, {cliente}! Aqui é {consultora}, da Auxiliadora Predial. Confirmando sua visita {dia} às {hora} no imóvel {codigo}{bairro}. Posso contar com você?")
  /// LGPD: anonimizar clientes sem atividade há N meses (0 = desligado)
  retentionMonths          Int      @default(24)
  /// LGPD: contato para pedidos de titulares (exibido no aviso de privacidade)
  privacyContact           String   @default("")
  retentionLastRunAt       DateTime?
  /// link do imóvel no site; {codigo} é substituído pelo código
  propertyUrlTemplate      String   @default("https://www.auxiliadorapredial.com.br/imovel/aluguel/{codigo}?tag=8086")
  /// meta de cobertura de registro (%) exibida no painel
  coverageGoal             Int      @default(90)
  /// oportunidade aberta sem movimento há N dias é destacada como parada
  staleOpportunityDays     Int      @default(7)
  updatedAt                DateTime @updatedAt
}

enum PatternKind {
  /// prefixo do título que identifica visita comercial (ex.: "visita clt")
  VISIT_PREFIX
  /// termo que exclui o evento (ex.: "visita tecnica", "almoco")
  EXCLUDE
  /// termo que torna o evento ambíguo → revisão (ex.: "visita")
  AMBIGUOUS
}

model EventPattern {
  id        String      @id @default(cuid())
  kind      PatternKind
  /// texto já normalizado (minúsculo, sem acento, espaços simples)
  pattern   String
  label     String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([kind, pattern])
}

enum ReasonKind {
  VISIT_NEGATIVE
  OPPORTUNITY_LOST
  /// cancelamento de visita (pré-atendimento)
  VISIT_CANCEL
  /// garantia da locação escolhida na pré-análise
  GUARANTEE
  /// diferenciais da locação (aviso ao marketing)
  LEASE_HIGHLIGHT
  /// agenciadores (aviso ao marketing)
  LEASE_AGENT
  /// o que pode faltar numa pré-análise pendente (documentos)
  PRE_MISSING
}

model Reason {
  id        String     @id @default(cuid())
  kind      ReasonKind
  label     String
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  /// "outro" exige observação descritiva (a observação já é sempre obrigatória)
  createdAt DateTime   @default(now())

  visits        Visit[]       @relation("VisitNegativeReason")
  canceledVisits Visit[]      @relation("VisitCancelReason")
  opportunities Opportunity[]
  preAnalyses   PreAnalysis[] @relation("PreAnalysisGuarantee")
  leasePosts    LeasePost[]   @relation("LeasePostAgent")

  @@unique([kind, label])
}

// ───────────────────────────── Google ─────────────────────────────

enum ConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
  DISCONNECTED
}

model GoogleConnection {
  id                   String           @id @default(cuid())
  googleEmail          String
  googleSub            String
  /// AES-256-GCM (ver src/lib/crypto.ts). Nunca enviado ao navegador.
  refreshTokenEnc      String?
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  scopes               String
  status               ConnectionStatus @default(CONNECTED)
  statusDetail         String?
  calendarId           String?
  calendarSummary      String?
  calendarAccessRole   String?
  connectedById        String?
  connectedBy          User?            @relation(fields: [connectedById], references: [id])
  connectedAt          DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

/// Batimento do worker (diagnóstico: worker ativo?)
model WorkerHeartbeat {
  id        String   @id
  beatAt    DateTime
  startedAt DateTime
  version   String?
}

model SyncState {
  calendarId          String    @id
  syncToken           String?
  windowStart         DateTime?
  windowEnd           DateTime?
  lastFullSyncAt      DateTime?
  lastReconcileAt     DateTime?
  lastSuccessAt       DateTime?
  lastAttemptAt       DateTime?
  consecutiveFailures Int       @default(0)
  nextAttemptAt       DateTime?
  lastErrorCode       String?
  updatedAt           DateTime  @updatedAt
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model SyncRun {
  id            String        @id @default(cuid())
  trigger       SyncTrigger
  status        SyncRunStatus
  mode          String?
  requestedById String?
  requestedBy   User?         @relation(fields: [requestedById], references: [id])
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  /// contagens apenas (sem dados pessoais)
  stats         Json?
  errorCode     String?
  errorMessage  String?

  @@index([status, createdAt])
  @@index([createdAt])
}

enum EventClass {
  VISIT
  AMBIGUOUS
  IRRELEVANT
}

enum ReviewDecision {
  ACCEPTED_AS_VISIT
  REJECTED
}

/// Espelho mínimo de eventos/ocorrências do Google.
/// Eventos IRRELEVANT guardam apenas identificadores e status (sem título/descrição/convidados).
model SourceEvent {
  id                String          @id @default(cuid())
  calendarId        String
  /// id da ocorrência (para recorrências, é o id da instância, não o da série)
  googleEventId     String
  recurringEventId  String?
  iCalUID           String?
  originalStartTime DateTime?
  googleStatus      String
  googleUpdatedAt   DateTime?
  etag              String?
  classification    EventClass
  reviewDecision    ReviewDecision?
  reviewedById      String?
  reviewedAt        DateTime?
  startAt           DateTime?
  endAt             DateTime?
  allDay            Boolean         @default(false)
  title             String?
  /// texto puro, sanitizado, sem bloco do Meet
  description       String?
  organizerEmail    String?
  /// [{email, responseStatus}] apenas para eventos de visita/ambíguos
  attendees         Json?
  attendeesOmitted  Boolean         @default(false)
  parsed            Json?
  missingSince      DateTime?
  /// limpeza dos dados de teste: o evento nunca mais vira visita (conteúdo já removido)
  ignoredAt         DateTime?
  /// cor do evento no Google ("1"–"11"; null = cor da agenda)
  colorId           String?
  /// quando o app pintou o evento (agendado pela consultora): pinta uma vez só, a cor trocada à mão fica
  colorPaintedAt    DateTime?
  /// cor que o app pôs (para tirar se a opção for desligada; cor trocada à mão não é mexida)
  paintedColorId    String?
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())

  visit Visit?

  @@unique([calendarId, googleEventId])
  @@index([classification, reviewDecision])
  @@index([iCalUID])
  @@index([startAt])
}

// ───────────────────────────── Clientes e imóveis ─────────────────────────────

enum IdentityStatus {
  /// telefone validado sem ambiguidade
  CONFIRMED
  /// sem telefone válido ou vínculo a confirmar
  PENDING
}

model Client {
  id             String         @id @default(cuid())
  name           String
  identityStatus IdentityStatus @default(PENDING)
  mergedIntoId   String?
  /// LGPD: dados pessoais removidos (retenção ou pedido do titular); métricas preservadas
  anonymizedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  phones        ClientPhone[]
  visits        Visit[]
  opportunities Opportunity[]
  searches      ClientSearch[]
  preAnalyses   PreAnalysis[]
  proposals     Proposal[]

  @@index([identityStatus])
}

model ClientPhone {
  id         String   @id @default(cuid())
  clientId   String
  raw        String
  /// E.164 quando validado; null quando inválido
  normalized String?
  valid      Boolean
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, raw])
  @@index([normalized])
}

model Property {
  id        String   @id @default(cuid())
  /// texto para preservar zeros à esquerda
  code      String   @unique
  createdAt DateTime @default(now())
  /// pré-visualização lida da página pública do imóvel (og:image / og:title)
  photoUrl      String?
  title         String?
  pageStatus    String?
  pageCheckedAt DateTime?
  /// dados públicos do anúncio (JSON-LD da página): tipo, bairro, cidade, valores em R$, área em m²
  category      String?
  neighborhood  String?
  city          String?
  rent          Int?
  totalPrice    Int?
  condoFee      Int?
  iptu          Int?
  /// até 8 fotos do anúncio (galeria da ficha da visita)
  photos        String[] @default([])
  /// todas as fotos do anúncio (até 40), mantidas quando o anúncio sai do site (cópia do marketing na locação)
  gallery       String[] @default([])
  area          Int?
  bedrooms      Int?
  /// endereço para a rota do dia (não é dado pessoal: é o endereço do imóvel)
  address       String?
  /// AGENDA = campo "local" do evento; MANUAL = digitado no app (a agenda não sobrescreve)
  addressSource String?
  addressUpdatedAt DateTime?
  /// coordenadas para o mapa (geocodificação do endereço ou do bairro; cache)
  lat           Float?
  lng           Float?
  /// texto que gerou as coordenadas (mudou o endereço → geocodifica de novo)
  geoQuery      String?
  /// ADDRESS = endereço; AREA = só bairro; NONE = não encontrado
  geoPrecision  String?
  geocodedAt    DateTime?

  visits        Visit[]
  opportunities Opportunity[]
}

// ───────────────────────────── Visitas ─────────────────────────────

enum VisitOrigin {
  GOOGLE
  MANUAL
}

enum VisitStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELED
  RESCHEDULED
}

enum Evaluation {
  POSITIVE
  NEGATIVE
  UNDECIDED
}

enum AssignmentStatus {
  AUTO
  MANUAL
  NEEDS_REVIEW
}

enum ClientMatch {
  /// cliente novo criado com telefone válido
  NEW_CONFIRMED
  /// mesmo telefone + nome compatível
  PHONE_MATCH
  /// telefone compartilhado ou nome incompatível → revisão
  SUGGESTED
  /// sem telefone válido
  NO_PHONE
  /// vínculo confirmado por pessoa (sync não altera)
  CONFIRMED_MANUAL
}

enum SyncConflict {
  NONE
  CANCELED_IN_GOOGLE
  DELETED_IN_GOOGLE
  NO_LONGER_VISIT
  CHANGED_AFTER_CONCLUSION
  POSSIBLE_RECREATION
}

model Visit {
  id               String           @id @default(cuid())
  origin           VisitOrigin
  sourceEventId    String?          @unique
  sourceEvent      SourceEvent?     @relation(fields: [sourceEventId], references: [id])
  scheduledStart   DateTime
  scheduledEnd     DateTime
  clientName       String?
  phoneRaw         String?
  phoneNormalized  String?
  propertyCode     String?
  /// número isolado antes de "cod" — significado não confirmado
  externalRef      String?
  /// campos corrigidos no app; sync nunca sobrescreve estes
  manualFields     String[]         @default([])
  consultantId     String?
  consultant       User?            @relation("VisitConsultant", fields: [consultantId], references: [id])
  assignmentStatus AssignmentStatus
  assignmentNote   String?
  /// consultora que marcou a visita (criadora do evento na agenda ou cadastro no app).
  /// null = agenda central (organizadora). Usado para distinguir revisitas marcadas pela consultora.
  scheduledById    String?
  scheduledBy      User?            @relation("VisitScheduledBy", fields: [scheduledById], references: [id])
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])
  clientMatch      ClientMatch      @default(NO_PHONE)
  /// ids de clientes candidatos quando SUGGESTED
  clientCandidates String[]         @default([])
  propertyId       String?
  property         Property?        @relation(fields: [propertyId], references: [id])
  opportunityId    String?
  opportunity      Opportunity?     @relation(fields: [opportunityId], references: [id])

  status           VisitStatus      @default(SCHEDULED)
  evaluation       Evaluation?
  negativeReasonId String?
  negativeReason   Reason?          @relation("VisitNegativeReason", fields: [negativeReasonId], references: [id])
  /// motivo do cancelamento (pré-atendimento)
  cancelReasonId   String?
  cancelReason     Reason?          @relation("VisitCancelReason", fields: [cancelReasonId], references: [id])
  /// imóvel indisponível trocado por outro no mesmo horário (código do novo): não conta como cancelamento do cliente
  swappedTo        String?
  note             String?
  concludedAt      DateTime?
  concludedById    String?
  concludedBy      User?            @relation("VisitConcludedBy", fields: [concludedById], references: [id])
  /// consultora responsável no momento da realização (atribuição de métricas)
  realizedById     String?
  realizedBy       User?            @relation("VisitRealizedBy", fields: [realizedById], references: [id])
  /// cancelamento automático por cancelamento no Google (antes de conclusão)
  autoCanceled     Boolean          @default(false)
  /// excluída dos indicadores pela gestora/admin (ex.: não era visita)
  excluded         Boolean          @default(false)
  syncConflict     SyncConflict     @default(NONE)
  conflictDetail   Json?
  /// controle de concorrência otimista
  version          Int              @default(1)
  /// última chave de idempotência aceita na conclusão
  lastRequestId    String?
  /// chave de idempotência do cadastro manual
  createRequestId  String?          @unique
  /// visita que esta substitui (reagendamento pela consultora)
  rescheduledFromId String?
  rescheduledFrom   Visit?          @relation("VisitRescheduled", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Visit[]         @relation("VisitRescheduled")
  /// evento com vários imóveis ("cod 339541;835840"): visita do 2º imóvel em diante, acompanha a visita do 1º
  companionOfId     String?
  companionOf       Visit?          @relation("VisitCompanions", fields: [companionOfId], references: [id], onDelete: SetNull)
  companions        Visit[]         @relation("VisitCompanions")
  /// evento criado pelo próprio app na agenda Google (sem precisar do botão "Colocar na agenda")
  googleCreatedAt   DateTime?
  /// código "VL-XXXXXX" levado no evento do Google criado pela consultora: liga o evento a esta visita sem duplicar
  linkCode          String?         @unique
  /// pré-análise que originou esta visita (funil pré-análise → visita → locação)
  preAnalysisId     String?
  preAnalysis       PreAnalysis?    @relation(fields: [preAnalysisId], references: [id], onDelete: SetNull)
  /// confirmação de presença com o cliente (WhatsApp aberto pela consultora): CONFIRMED | NO_REPLY
  confirmStatus     String?
  confirmedAt       DateTime?
  /// "ainda decidindo": dia de ligar de volta; concluído quando a consultora marca feito
  followUpOn        DateTime?       @db.Date
  followUpDoneAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  history VisitOutcomeHistory[]
  docRequests DocRequest[]

  @@index([consultantId, scheduledStart])
  @@index([status, scheduledEnd])
  @@index([scheduledStart])
  @@index([clientId])
  @@index([propertyId])
  @@index([opportunityId])
  @@index([phoneNormalized])
  @@index([consultantId, followUpOn])
  @@index([preAnalysisId])
  @@index([companionOfId])
}

/// Histórico de conclusões/alterações de resultado (observações anteriores).
model VisitOutcomeHistory {
  id               String       @id @default(cuid())
  visitId          String
  visit            Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  status           VisitStatus
  evaluation       Evaluation?
  negativeReasonId String?
  note             String?
  authorId         String?
  author           User?        @relation(fields: [authorId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([visitId, createdAt])
}

// ───────────────────────────── Oportunidades ─────────────────────────────

enum OpportunityStatus {
  FOLLOW_UP
  DOCS_REVIEW
  CLOSED_WON
  LOST
}

enum LostOrigin {
  /// encerrada por visita avaliada como negativa
  VISIT_NEGATIVE
  /// perda posterior registrada no andamento
  LATER
}

/// Situação do negócio depois da visita (fluxo da agência: mesmas situações das planilhas).
/// ordem do fluxo em src/lib/deal-stages.ts; DOCS é antiga (virou APPROVED) e não é mais usada
enum DealStage {
  NEGOTIATION
  OWNER_PENDING
  PRE_ANALYSIS
  KYC_SENT
  ANALYSIS
  DOCS
  APPROVED
  INSPECTION
  CONTRACT
  SIGNED
  POSSESSION
}

enum DealType {
  LEASE
  INTERMEDIATION
}

model Opportunity {
  id                   String            @id @default(cuid())
  /// situação no fluxo (null = em acompanhamento, cliente ainda decidindo); "Caiu" = status LOST com lostStage
  stage                DealStage?
  stageChangedAt       DateTime          @default(now())
  lostStage            DealStage?
  // 1. Em negociação
  proposedRentCents    Int?
  intendedGuarantee    String?
  // 2. Aguardando o proprietário
  proposalSentAt       DateTime?         @db.Date
  ownerAcceptedAt      DateTime?         @db.Date
  agreedRentCents      Int?
  // 3. KYC enviado
  kycSentAt            DateTime?         @db.Date
  kycDueAt             DateTime?         @db.Date
  // 4. Análise e garantia
  guarantee            String?
  analysisDecidedAt    DateTime?         @db.Date
  // 5. Documentação
  docsMissing          String[]          @default([])
  docsRequestedAt      DateTime?         @db.Date
  // 6. Formalização
  contractReleasedAt   DateTime?         @db.Date
  contractSentAt       DateTime?         @db.Date
  inspectionNeeded     Boolean?
  // 7. Assinatura (entra no VGL)
  signedAt             DateTime?         @db.Date
  dealType             DealType?
  contractValueCents   Int?
  // 8. Posse
  possessionAt         DateTime?         @db.Date
  keysHolderChecked    Boolean           @default(false)
  // pós-contrato (consultora com a opção ligada): contato de boas-vindas e pedido de indicação, 5 dias cada
  aftercareWelcomeAt   DateTime?
  aftercareReferralAt  DateTime?
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id])
  propertyId           String
  property             Property          @relation(fields: [propertyId], references: [id])
  cycle                Int               @default(1)
  status               OpportunityStatus @default(FOLLOW_UP)
  responsibleId        String?
  responsible          User?             @relation("OppResponsible", fields: [responsibleId], references: [id])
  /// data da primeira visita realizada (coorte)
  firstDoneVisitAt     DateTime
  closedAt             DateTime?         @db.Date
  closedResponsibleId  String?
  closedResponsible    User?             @relation("OppClosedResponsible", fields: [closedResponsibleId], references: [id])
  lostAt               DateTime?
  lostOrigin           LostOrigin?
  lostReasonId         String?
  lostReason           Reason?           @relation(fields: [lostReasonId], references: [id])
  lostNote             String?
  version              Int               @default(1)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  visits Visit[]
  events OpportunityEvent[]
  docRequests DocRequest[]
  leasePost LeasePost?

  @@unique([clientId, propertyId, cycle])
  @@index([status])
  @@index([responsibleId])
  @@index([firstDoneVisitAt])
  @@index([closedAt])
  // índice único parcial (1 ativa por cliente+imóvel) criado na migração SQL
}

model OpportunityEvent {
  id            String             @id @default(cuid())
  opportunityId String
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStatus    OpportunityStatus?
  toStatus      OpportunityStatus
  fromStage     DealStage?
  toStage       DealStage?
  note          String?
  authorId      String?
  author        User?              @relation(fields: [authorId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([opportunityId, createdAt])
}

// ───────────────────────────── Auditoria ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────────── Lembretes (Web Push) ─────────────────────────────

/** Inscrição de notificação de um aparelho. Conteúdo das notificações: só contagens, sem dados de clientes. */
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/** Um lembrete por usuário por dia (idempotência entre reinícios e réplicas do worker). */
model ReminderLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// dia operacional YYYY-MM-DD
  day       String
  kind      String
  count     Int
  delivered Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, day, kind])
}

// ───────────────────────────── Monitoramento de erros ─────────────────────────────

/** Erro agrupado por assinatura. Mensagens são limpas de e-mails, telefones e números longos. */
model ErrorEvent {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  source      String
  message     String
  path        String?
  count       Int      @default(1)
  lastUserId  String?
  notifiedAt  DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// ───────────────────────────── Backups ─────────────────────────────

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Backups diários (arquivo criptografado no armazenamento externo). Sem dados pessoais aqui: só metadados.
model BackupRun {
  id         String       @id @default(cuid())
  status     BackupStatus
  trigger    String
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  /// nome do arquivo no armazenamento
  objectKey  String?
  sizeBytes  Int?
  rows       Int?
  errorCode  String?
  @@index([startedAt])
}

// ───────────────────────────── Pré-análise (antes de agendar visita) ─────────────────────────────

enum PreAnalysisStatus {
  /// enviada à consultora, aguardando análise
  AWAITING
  APPROVED
  REJECTED
  /// pendente (ex.: faltam documentos); continua em aberto
  PENDING
}

/// Dados do titular do CPF para pré-análise feita fora do sistema pela consultora.
/// LGPD: CPF, nascimento, e-mail, telefone e salário ficam CRIPTOGRAFADOS (AES-256-GCM) e são apagados
/// automaticamente N dias após o resultado (AppSettings.preAnalysisRetentionDays). Ficam só nome, faixa de renda,
/// resultado e datas para os indicadores.
model PreAnalysis {
  id           String            @id @default(cuid())
  /// idempotência do envio (toque duplo / reenvio não duplica)
  requestId    String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdById  String
  createdBy    User              @relation("PreAnalysisCreatedBy", fields: [createdById], references: [id])
  consultantId String
  consultant   User              @relation("PreAnalysisConsultant", fields: [consultantId], references: [id])
  status       PreAnalysisStatus @default(AWAITING)
  fullName     String
  /// HMAC do CPF (detecta repetição sem guardar o número em claro)
  cpfHash      String?
  /// HMAC do telefone normalizado: liga a pré-análise ao cadastro do cliente sem guardar o número em claro
  phoneHash    String?
  /// cadastro do cliente (ficha única): pelo telefone ou pela visita gerada a partir da pré-análise
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  cpfEnc       String?
  birthDateEnc String?
  emailEnc     String?
  phoneEnc     String?
  /// salário em centavos (criptografado)
  salaryEnc    String?
  /// faixa de renda (fica após a remoção dos dados): ate2k, 2a4k, 4a6k, 6a10k, 10kmais
  incomeBand   String
  /// imóvel de interesse (opcional)
  propertyCode String?
  /// pendente: o que falta (rótulos da lista "o que pode faltar")
  missingItems String[]          @default([])
  /// cliente já era da consultora: a pré-análise vai para ela sem contar a vez no rodízio
  ownClient    Boolean           @default(false)
  /// garantia da locação (Fiador, Seguro fiança, CredPago…)
  guaranteeId  String?
  guarantee    Reason?           @relation("PreAnalysisGuarantee", fields: [guaranteeId], references: [id])
  note         String?
  resultNote   String?
  resultAt     DateTime?
  resultById   String?
  resultBy     User?             @relation("PreAnalysisResolvedBy", fields: [resultById], references: [id])
  /// dados sensíveis apagados (retenção LGPD)
  purgedAt     DateTime?
  visits       Visit[]
  files        PreAnalysisFile[]
  docRequests  DocRequest[]

  @@index([consultantId, status])
  @@index([createdAt])
  @@index([cpfHash])
  @@index([phoneHash])
  @@index([clientId])
}

// ───────────────────────────── Propostas ─────────────────────────────

enum ProposalStatus {
  /// aguardando a consultora
  NEW
  /// enviada ao proprietário
  SENT
  /// proprietário fez contraproposta
  COUNTER
  ACCEPTED
  REJECTED
}

/// Proposta de valor de aluguel: o pré-atendimento registra e encaminha à consultora da vez (mesmo rodízio da pré-análise).
model Proposal {
  id           String         @id @default(cuid())
  /// idempotência do envio (toque duplo / reenvio não duplica)
  requestId    String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String
  createdBy    User           @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  consultantId String
  consultant   User           @relation("ProposalConsultant", fields: [consultantId], references: [id])
  clientName   String
  /// telefone cifrado; a impressão (HMAC) liga ao cadastro do cliente sem guardar o número em claro
  phoneEnc     String?
  phoneHash    String?
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// valor proposto para o aluguel, em centavos
  rentCents    Int
  propertyCode String
  /// cliente já era da consultora: vai para ela sem contar a vez no rodízio
  ownClient    Boolean        @default(false)
  note         String?
  status       ProposalStatus @default(NEW)
  /// valor da contraproposta do proprietário, em centavos
  counterCents Int?
  resultNote   String?
  statusAt     DateTime?
  statusById   String?
  statusBy     User?          @relation("ProposalStatusBy", fields: [statusById], references: [id])
  /// telefone apagado (retenção LGPD)
  purgedAt     DateTime?

  @@index([consultantId, status])
  @@index([status])
  @@index([createdAt])
  @@index([phoneHash])
  @@index([clientId])
}

/// Locação fechada → aviso ao marketing para postar (diferencial e agenciador obrigatórios no fechamento).
model LeasePost {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Reason      @relation("LeasePostAgent", fields: [agentId], references: [id])
  /// diferenciais marcados (rótulos no momento do fechamento)
  highlights    String[]    @default([])
  highlightNote String
  createdById   String
  createdBy     User        @relation("LeasePostCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  postedAt      DateTime?
  postedById    String?
  postedBy      User?       @relation("LeasePostPostedBy", fields: [postedById], references: [id])
  /// cópia das fotos do anúncio para o marketing (o anúncio sai do site depois de alugado)
  photos          LeasePhoto[]
  /// OK = fotos guardadas; NONE = anúncio sem fotos; ERROR = falhou (o worker tenta de novo)
  photosStatus    String?
  photosCheckedAt DateTime?
  photoAttempts   Int         @default(0)

  @@index([postedAt])
}

/// Foto do anúncio guardada para o marketing baixar (não é dado pessoal: é a foto pública do imóvel).
model LeasePhoto {
  id          String    @id @default(cuid())
  leasePostId String
  leasePost   LeasePost @relation(fields: [leasePostId], references: [id], onDelete: Cascade)
  position    Int
  sourceUrl   String
  mime        String
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now())

  @@unique([leasePostId, sourceUrl])
  @@index([leasePostId, position])
}

/// Documentos do cliente anexados à pré-análise (RG, comprovante de renda…).
/// LGPD: conteúdo CRIPTOGRAFADO (AES-256-GCM) e apagado junto com os demais dados pessoais na retenção.
model PreAnalysisFile {
  id            String      @id @default(cuid())
  preAnalysisId String
  preAnalysis   PreAnalysis @relation(fields: [preAnalysisId], references: [id], onDelete: Cascade)
  name          String
  mime          String
  size          Int
  /// iv (12) + tag (16) + conteúdo cifrado
  data          Bytes
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([preAnalysisId])
}

/// Cancelamento feito pelo pré-atendimento: o que mudou (no app e no Google) para poder desfazer por alguns instantes.
model VisitCancelUndo {
  id              String    @id @default(cuid())
  actorId         String
  visitIds        String[]
  calendarId      String?
  googleEventId   String?
  /// moved | code_removed | (antigos: canceled | removed) | (nada no Google)
  googleAction    String?
  previousSummary String?
  newSummary      String?
  /// "moved": horário do evento antes de ir para as 22h (o desfazer volta para ele)
  previousStart   DateTime?
  previousEnd     DateTime?
  createdAt       DateTime  @default(now())
  undoneAt        DateTime?

  @@index([createdAt])
}

// ───────────────────────────── Documentos pelo link do cliente ─────────────────────────────

enum DocRequestStatus {
  /// aguardando o cliente enviar
  OPEN
  /// cliente concluiu o envio
  SUBMITTED
  /// link cancelado pela equipe
  CANCELED
}

/// Pedido de documentos ao cliente: um link seguro (token) que ele abre no celular para fotografar/enviar.
/// LGPD: telefone e token ficam cifrados; os arquivos (ClientDocument) também; tudo é apagado no prazo de retenção.
model DocRequest {
  id             String           @id @default(cuid())
  /// SHA-256 do token do link (para localizar); o token cifrado permite reenviar o mesmo link
  tokenHash      String           @unique
  tokenEnc       String?
  preAnalysisId  String?
  preAnalysis    PreAnalysis?     @relation(fields: [preAnalysisId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  visitId        String?
  visit          Visit?           @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /// consultora responsável (avisada quando o cliente envia)
  consultantId   String?
  consultant     User?            @relation("DocRequestConsultant", fields: [consultantId], references: [id])
  createdById    String
  createdBy      User             @relation("DocRequestCreatedBy", fields: [createdById], references: [id])
  clientName     String
  /// telefone E.164 cifrado (para o WhatsApp e para a verificação)
  phoneEnc       String?
  /// verificação no link: "CPF" (3 primeiros dígitos) ou "PHONE" (4 últimos dígitos do celular)
  verifyKind     String
  /// HMAC dos dígitos de verificação
  verifyHash     String?
  /// [{ key, label, hint, required }]
  items          Json
  message        String?
  propertyCode   String?
  status         DocRequestStatus @default(OPEN)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  openedAt       DateTime?
  verifiedAt     DateTime?
  lastActivityAt DateTime?
  submittedAt    DateTime?
  canceledAt     DateTime?
  failedAttempts Int              @default(0)
  lockedUntil    DateTime?
  /// dados pessoais e arquivos apagados (retenção LGPD)
  purgedAt       DateTime?
  files          ClientDocument[]

  @@index([preAnalysisId])
  @@index([opportunityId])
  @@index([visitId])
  @@index([status, expiresAt])
  @@index([createdAt])
}

/// Arquivo enviado pelo cliente no link. Conteúdo CIFRADO (AES-256-GCM): iv (12) + tag (16) + dados.
model ClientDocument {
  id        String     @id @default(cuid())
  requestId String
  request   DocRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// item da lista pedida (ex.: "doc_foto", "renda")
  itemKey   String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime   @default(now())

  @@index([requestId, itemKey])
}

// ───────────────────────────── Cliente em busca ─────────────────────────────

enum ClientSearchStatus {
  /// segue procurando imóvel com a gente
  ACTIVE
  /// alugou conosco (encerrada sozinha quando o contrato é assinado)
  WON
  /// alugou com outra imobiliária / por conta própria
  LOST_ELSEWHERE
  /// desistiu de alugar / parou de responder
  GAVE_UP
}

/// Cliente que recusou um imóvel mas continua procurando (outro perfil). Separado do negócio cliente+imóvel,
/// para não inflar o funil. No máximo uma busca ativa por cliente (índice parcial na migração).
model ClientSearch {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultantId   String
  consultant     User               @relation("ClientSearchConsultant", fields: [consultantId], references: [id])
  status         ClientSearchStatus @default(ACTIVE)
  /// perfil (tudo opcional): valor total máximo em centavos, regiões, tipo, quartos, o que não quer, observação
  maxBudgetCents Int?
  areas          String[]           @default([])
  propertyType   String?
  bedrooms       Int?
  mustNot        String?
  note           String?
  /// visita/negócio de onde a busca nasceu
  sourceVisitId  String?
  startedAt      DateTime           @default(now())
  lastContactAt  DateTime?
  /// dia combinado para falar de novo (aparece em "ligar hoje")
  followUpOn     DateTime?          @db.Date
  closedAt       DateTime?
  closedById     String?
  closedBy       User?              @relation("ClientSearchClosedBy", fields: [closedById], references: [id])
  closeNote      String?
  createdById    String
  updatedAt      DateTime           @updatedAt

  @@index([consultantId, status])
  @@index([clientId, status])
  @@index([status, followUpOn])
}

